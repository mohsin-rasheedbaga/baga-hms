{
  "name": "baga-hms",
  "version": "3.5.1",
  "private": true,
  "description": "BAGA Hospital Management System - Desktop Edition",
  "main": "electron/main.js",
  "author": "BAGA Hospital",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"next build && next start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder --win --x64",
    "electron:build:portable": "next build && electron-builder --win portable --x64",
    "electron:build:setup": "next build && electron-builder --win nsis --x64",
    "electron:start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:zip": "electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "electron-updater": "^6.3.9",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/better-sqlite3": "^7.6.12",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.baga.hospital.hms",
    "productName": "BAGA Hospital Management System",
    "copyright": "Copyright 2024 BAGA Hospital",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BAGA HMS",
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "BAGA-HMS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BAGA-HMS-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mohsin-rasheedbaga",
      "repo": "baga-hms"
    }
  }
}
